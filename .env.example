# Database Configuration
DB_USER=puckwise
DB_PASSWORD=your_secure_password_here
DB_NAME=hockey_analytics
DB_HOST=localhost
DB_PORT=5432

# Full database URL (used by ETL, ML, and API)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# NHL API (no auth required)
NHL_API_BASE_URL=https://api-web.nhle.com/v1
NHL_STATS_API_BASE_URL=https://api.nhle.com/stats/rest/en

# MoneyPuck (no auth required)
MONEYPUCK_BASE_URL=https://moneypuck.com/moneypuck/playerData

# API Configuration
API_PORT=8080
API_HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api

# Environment
ENVIRONMENT=development
